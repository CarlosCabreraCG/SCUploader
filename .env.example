# Copia este archivo a ".env" y completa tus datos reales.
# El archivo ".env" NUNCA debe subirse a un repositorio (ver .gitignore).

# API keys de SensorCloud (dispositivo origen y destino)
API_KEY_SOURCE=tu_api_key_origen
API_KEY_DEST=tu_api_key_destino

# IDs de los dispositivos SensorCloud
SOURCE_DEVICE=W020000000198806
DEST_DEVICE=OAPI007627ZU9AWY

# Opcional: servidor de autenticación (por defecto sensorcloud.microstrain.com)
# SENSORCLOUD_SERVER=sensorcloud.microstrain.com
